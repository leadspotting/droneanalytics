{
  "name": "drone-oversight-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.js && vitest run",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "concurrently --kill-others --names \"API,UI\" --prefix-colors \"cyan,magenta\" \"python run.py --api\" \"vite\""
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "leaflet-draw": "^1.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^9.1.2",
    "jsdom": "^26.1.0",
    "vite": "^8.3.6",
    "vitest": "^4.1.12"
  }
}
